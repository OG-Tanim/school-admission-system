# Copy to `.env` to override the defaults used by `docker compose up`.
# `.env` is git-ignored.

# Backend URL the UI uses by default. Can also be changed from the UI at runtime.
API_URL=http://localhost:8080

# Seat-hold lifetime in seconds (the backend default is 600).
HOLD_DURATION_SECONDS=600

POSTGRES_DB=school_admission
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
