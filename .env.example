# Copy this file to `.env` to override the defaults used by `docker compose up`.
# `.env` is git-ignored and must never be committed.

# Backend URL the frontend starts with. The "Backend URL" field in the UI
# stores a per-user override in the browser and never writes config/api-url.env.
API_URL=http://localhost:8080

# Seat-hold lifetime in seconds (the backend default is 600).
HOLD_DURATION_SECONDS=600

POSTGRES_DB=school_admission
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Full database connection string (Npgsql format). Setting this overrides the
# POSTGRES_* values above for the backend only. Leave it commented out to use the
# in-network default assembled from POSTGRES_*.
# ConnectionStrings__DefaultConnection=Host=db;Port=5432;Database=school_admission;Username=postgres;Password=postgres

